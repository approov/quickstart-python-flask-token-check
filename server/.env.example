# For production usage the secret is always retrieved with the Approov CLI tool,
# that can be also used to generate valid and invalid tokens for testing purposes.
# Please check the Approov docs at https://ext.approov.io/docs/latest/approov-cli-tool-reference/#token-commands.
#
# For following along this server examples you just need get secret with `approov secret -get base64`
APPROOV_BASE64_SECRET=approov_base64_secret_here
